model HealthRecord {
  id         String      @id @default(uuid()) @db.Uuid
  patient_id String      @unique @db.Uuid
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @updatedAt @db.Timestamptz(6)
  version    Int         @default(1)
  encounters Encounter[]
  patient    User        @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@map("health_records")
}

model Encounter {
  id               String          @id @default(uuid()) @db.Uuid
  health_record_id String          @db.Uuid
  appointment_id   String?         @db.Uuid
  doctor_id        String          @db.Uuid
  encounter_type   String
  notes_encrypted  Bytes?
  status           EncounterStatus @default(OPEN)
  occurred_at      DateTime        @default(now()) @db.Timestamptz(6)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @updatedAt @db.Timestamptz(6)
  version          Int             @default(1)
  appointment      Appointment?    @relation(fields: [appointment_id], references: [id])
  doctor           Doctor          @relation(fields: [doctor_id], references: [id])
  health_record    HealthRecord    @relation(fields: [health_record_id], references: [id], onDelete: Cascade)
  prescriptions    Prescription[]
  reviews          Review[]

  @@map("encounters")
}

model Consent {
  id           String    @id @default(uuid()) @db.Uuid
  patient_id   String    @db.Uuid
  consent_type String
  granted      Boolean
  granted_at   DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)
  version      Int       @default(1)
  patient      User      @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@map("consents")
}

model Review {
  id           String       @id @default(uuid()) @db.Uuid
  patient_id   String       @db.Uuid
  subject_type ProviderType
  subject_id   String       @db.Uuid
  encounter_id String       @db.Uuid
  rating       Int
  comment      String?
  status       String       @default("PENDING")
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime     @updatedAt @db.Timestamptz(6)
  version      Int          @default(1)
  encounter    Encounter    @relation(fields: [encounter_id], references: [id])
  patient      User         @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model FraudFlag {
  id           String   @id @default(uuid()) @db.Uuid
  subject_type String
  subject_id   String   @db.Uuid
  flag_type    String
  severity     String
  status       String   @default("OPEN")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
  version      Int      @default(1)

  @@map("fraud_flags")
}

model DeliveryOrder {
  id                    String         @id @default(uuid()) @db.Uuid
  pharmacy_order_id     String         @db.Uuid
  courier_type          CourierType
  address_id            String         @db.Uuid
  status                DeliveryStatus @default(PENDING)
  otp_code_hash         String?
  proof_of_delivery_url String?
  fee                   Decimal        @db.Decimal(10, 2)
  eta_at                DateTime?      @db.Timestamptz(6)
  created_at            DateTime       @default(now()) @db.Timestamptz(6)
  updated_at            DateTime       @updatedAt @db.Timestamptz(6)
  version               Int            @default(1)
  address               Address        @relation(fields: [address_id], references: [id])
  pharmacy_order        PharmacyOrder  @relation(fields: [pharmacy_order_id], references: [id], onDelete: Cascade)

  @@map("delivery_orders")
}
