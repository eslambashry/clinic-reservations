model User {
  id                   String     @id @default(uuid()) @db.Uuid
  phone                String     @unique
  email                String?    @unique
  /// File 12 Part 32.1: nullable — OTP-only signup collects no name; this is
  /// the display-name source for both Patient profile (File 11 05.2) and
  /// Doctor search/detail (05.4), neither of which had anywhere else to
  /// store one.
  first_name           String?
  last_name            String?
  password_hash        String?
  password_updated_at  DateTime?  @db.Timestamptz(6)
  status               UserStatus @default(ACTIVE)
  created_at           DateTime   @default(now()) @db.Timestamptz(6)
  updated_at           DateTime   @updatedAt @db.Timestamptz(6)
  deleted_at           DateTime?  @db.Timestamptz(6)
  version              Int        @default(1)

  role_memberships                RoleMembership[]
  devices                         Device[]
  refresh_tokens                  RefreshToken[]
  doctor                          Doctor?
  appointment_holds               AppointmentHold[]
  cancelled_appointments          Appointment[]                  @relation("CancelledAppointments")
  appointments                    Appointment[]                  @relation("PatientAppointments")
  audit_logs                      AuditLog[]                     @relation("ActorUser")
  consents                        Consent[]
  health_record                   HealthRecord?
  lab_orders                      LabOrder[]
  lab_order_notes_authored        LabOrderNote[]
  lab_result_documents_uploaded   LabResultDocument[]
  notification_preferences        NotificationPreference[]
  notifications                   Notification[]
  payment_intents                 PaymentIntent[]
  pharmacy_orders                 PharmacyOrder[]
  policy_configs_created          PolicyConfig[]                 @relation("CreatedByPolicyConfig")
  prescription_reviews            PrescriptionReview[]
  prescriptions_authored          Prescription[]                 @relation("DoctorPrescriptions")
  prescriptions                   Prescription[]                 @relation("PatientPrescriptions")
  provider_verifications_reviewed ProviderVerificationDocument[] @relation("ReviewedByAdmin")
  reviews                         Review[]
  substitutions_proposed          Substitution[]

  @@map("users")
}

model Role {
  code             String           @id
  name             String
  description      String?
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @updatedAt @db.Timestamptz(6)
  version          Int              @default(1)
  role_memberships RoleMembership[]
  role_permissions RolePermission[]

  @@map("roles")
}

model Permission {
  code             String           @id
  module           String
  action           String
  description      String?
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @updatedAt @db.Timestamptz(6)
  version          Int              @default(1)
  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id              String     @id @default(uuid()) @db.Uuid
  role_code       String
  permission_code String
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  updated_at      DateTime   @updatedAt @db.Timestamptz(6)
  version         Int        @default(1)
  permission      Permission @relation(fields: [permission_code], references: [code], onDelete: Cascade)
  role            Role       @relation(fields: [role_code], references: [code], onDelete: Cascade)

  @@unique([role_code, permission_code])
  @@map("role_permissions")
}

model RoleMembership {
  id           String               @id @default(uuid()) @db.Uuid
  user_id      String               @db.Uuid
  role_code    String
  context_type RoleContextType
  context_id   String?              @db.Uuid
  status       RoleMembershipStatus @default(ACTIVE)
  created_at   DateTime             @default(now()) @db.Timestamptz(6)
  updated_at   DateTime             @updatedAt @db.Timestamptz(6)
  version      Int                  @default(1)
  role         Role                 @relation(fields: [role_code], references: [code])
  user         User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("role_memberships")
}

model OtpRequest {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String
  code_hash   String
  purpose     String
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  attempts    Int       @default(0)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  version     Int       @default(1)

  @@map("otp_requests")
}

model Device {
  id             String         @id @default(uuid()) @db.Uuid
  user_id        String         @db.Uuid
  fcm_token      String
  platform       String
  app_version    String?
  last_seen_at   DateTime       @default(now()) @db.Timestamptz(6)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @updatedAt @db.Timestamptz(6)
  version        Int            @default(1)
  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_tokens RefreshToken[]

  @@map("devices")
}

model RefreshToken {
  id                    String    @id @default(uuid()) @db.Uuid
  user_id               String    @db.Uuid
  token_hash            String    @unique
  device_id             String?   @db.Uuid
  rotated_from_token_id String?   @db.Uuid
  expires_at            DateTime  @db.Timestamptz(6)
  revoked_at            DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @updatedAt @db.Timestamptz(6)
  version               Int       @default(1)
  device                Device?   @relation(fields: [device_id], references: [id])
  user                  User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
