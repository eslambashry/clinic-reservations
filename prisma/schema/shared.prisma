generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// SHARED ENUMS (Native PostgreSQL Enums)
// ==========================================

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("users_status_enum")
}

enum RoleContextType {
  PATIENT
  DOCTOR
  CLINIC_STAFF
  PHARMACY_STAFF
  LAB_STAFF
  ADMIN

  @@map("role_memberships_context_type_enum")
}

enum RoleMembershipStatus {
  ACTIVE
  REVOKED

  @@map("role_memberships_status_enum")
}

enum DoctorStatus {
  PENDING
  VERIFIED
  SUSPENDED

  @@map("doctors_status_enum")
}

enum ProviderStatus {
  PENDING
  VERIFIED
  SUSPENDED

  @@map("provider_status_enum")
}

enum AffiliationStatus {
  ACTIVE
  PAUSED

  @@map("doctor_clinic_affiliations_status_enum")
}

enum ProviderType {
  DOCTOR
  CLINIC
  PHARMACY
  LAB

  @@map("provider_type_enum")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("provider_verification_documents_status_enum")
}

enum SlotStatus {
  OPEN
  HELD
  BOOKED
  BLOCKED

  @@map("appointment_slots_status_enum")
}

enum HoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED

  @@map("appointment_holds_status_enum")
}

enum AppointmentStatus {
