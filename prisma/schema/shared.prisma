  COMPLETED

  @@map("encounters_status_enum")
}

enum PrescriptionSource {
  DOCTOR_ISSUED
  PATIENT_UPLOADED

  @@map("prescriptions_source_enum")
}

enum PrescriptionStatus {
  UPLOADED
  QUALITY_CHECK_PASSED
  QUALITY_CHECK_FAILED
  ACCEPTED
  REJECTED
  CANCELLED

  @@map("prescriptions_status_enum")
}

enum QualityCheckStatus {
  PENDING
  PASSED
  FAILED

  @@map("prescription_images_quality_check_status_enum")
}

enum PrescriptionReviewDecision {
  ACCEPTED
  REJECTED
  NEEDS_CLARIFICATION

  @@map("prescription_reviews_decision_enum")
}

enum PharmacyOrderStatus {
  RECEIVED
  UNDER_REVIEW
  ACCEPTED
  SUBSTITUTION_PROPOSED
  REJECTED
  PAID
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  FULFILLED
  CANCELLED

  @@map("pharmacy_orders_status_enum")
}

enum FulfillmentType {
  PICKUP
  DELIVERY

  @@map("pharmacy_orders_fulfillment_type_enum")
}

enum BroadcastResponse {
  ACCEPTED
  DECLINED
  TIMEOUT

  @@map("pharmacy_order_broadcasts_response_enum")
}

enum PharmacyOrderItemStatus {
  AVAILABLE
  UNAVAILABLE
  SUBSTITUTED

  @@map("pharmacy_order_items_status_enum")
}

enum SubstitutionDecision {
  PENDING
  APPROVED
  REJECTED

  @@map("substitutions_patient_decision_enum")
}

enum PayableType {
  APPOINTMENT
  PHARMACY_ORDER
  LAB_ORDER

  @@map("payment_intents_payable_type_enum")
}

enum PaymentIntentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  SETTLED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_intents_status_enum")
}

enum PaymentAttemptStatus {
  INITIATED
  SUCCEEDED
  FAILED

  @@map("payment_attempts_status_enum")
}

enum PayeeType {
  PLATFORM
  PROVIDER

  @@map("payment_splits_payee_type_enum")
}

enum SplitType {
  COMMISSION
  PROVIDER_SHARE

  @@map("payment_splits_type_enum")
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED

  @@map("refunds_status_enum")
}

enum LedgerEntryType {
  EARNING
  COMMISSION_DEDUCTION
  PAYOUT
  ADJUSTMENT

  @@map("provider_ledger_entries_entry_type_enum")
}

enum CourierType {
  PHARMACY_OWN
  THIRD_PARTY

  @@map("delivery_orders_courier_type_enum")
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
