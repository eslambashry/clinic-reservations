  @@map("delivery_orders_status_enum")
}

enum NotificationTier {
  TRANSACTIONAL
  INFORMATIONAL
  SAFETY_CRITICAL
  MARKETING

  @@map("notifications_tier_enum")
}

enum PolicyType {
  COMMISSION_RATE
  CANCELLATION_TIER
  NOTIFICATION_QUIET_HOURS

  @@map("policy_configs_policy_type_enum")
}

// ==========================================
// SHARED MODELS
// ==========================================

model PolicyConfig {
  id             String     @id @default(uuid()) @db.Uuid
  region_code    String
  policy_type    PolicyType
  value          Json
  effective_from DateTime   @default(now()) @db.Timestamptz
  created_by     String?    @db.Uuid
  created_at     DateTime   @default(now()) @db.Timestamptz
  updated_at     DateTime   @updatedAt @db.Timestamptz
  version        Int        @default(1)

  creator User? @relation("CreatedByPolicyConfig", fields: [created_by], references: [id])

  @@map("policy_configs")
}

model WebhookEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  provider           String
  event_type         String
  payload            Json
  signature_verified Boolean   @default(false)
  idempotency_key    String    @unique
  processed_at       DateTime? @db.Timestamptz
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @updatedAt @db.Timestamptz
  version            Int       @default(1)

  @@map("webhook_events")
}
