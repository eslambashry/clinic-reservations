/// UNREVIEWED until a human makes the critical/non-critical call
/// (`SetCriticalFlagUseCase`) — always flips to REVIEWED in that same call,
/// so `isCritical && UNREVIEWED` is not a reachable combination (the safety
/// invariant `medsuper-laboratory-dashboard/docs/PROPOSED_CONTRACT.md` §2
/// calls out explicitly).
enum ResultReviewState {
  UNREVIEWED
  REVIEWED

  @@map("lab_result_documents_review_state_enum")
}
