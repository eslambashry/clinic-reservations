# Copy to .env and fill in real values. Never commit the real .env (see .gitignore).

NODE_ENV=development
PORT=3000

# Neon Postgres — pooled (PgBouncer, sslmode=require) for app runtime queries.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
# Neon Postgres — direct connection, used by Prisma Migrate only.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

REDIS_ENABLED=true
REDIS_URL="redis://localhost:6379"

# Signs/verifies short-lived access JWTs (File 11 Part 07.1). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"

# Comma-separated browser-origin allowlist. Optional — unset means "reflect
# any Origin" (fine for local dev only). Set this before any real deployment,
# e.g. CORS_ALLOWED_ORIGINS="https://app.medsuper.example,https://admin.medsuper.example"
CORS_ALLOWED_ORIGINS=
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/lnxadrrqf"
IMAGEKIT_PUBLIC_KEY="public_4DcuZFvfLH0+W1rErUzAlJRWva0="
IMAGEKIT_PRIVATE_KEY="private_5mAvjO17abhlti+JjF/sqVizA4U="

# Optional — login password `npm run db:seed` sets on demo PHARMACY_STAFF/
# LAB_STAFF accounts. Local-dev-only, never a real credential; unset uses a
# fixed fallback (see src/db/seed.ts).
SEED_DEMO_STAFF_PASSWORD=

# Paymob (DEC-001, File 12 Part 50) — all optional. Leave unset to run the
# app with online payments (card/Fawry/mobile wallet, wallet top-up)
# disabled; every other feature (pay-at-clinic, internal-wallet appointment
# payment) works without these. Get them from https://accept.paymob.com ->
# Settings -> Account Info (API key, HMAC secret) and Developers -> Payment
# Integrations (integration IDs, iframe ID).
PAYMOB_API_KEY=ZXlKaGJHY2lPaUpJVXpVeE1pSXNJblI1Y0NJNklrcFhWQ0o5LmV5SmpiR0Z6Y3lJNklrMWxjbU5vWVc1MElpd2ljSEp2Wm1sc1pWOXdheUk2TVRJeU5UWXlPQ3dpYm1GdFpTSTZJbWx1YVhScFlXd2lmUS5hUzUzeHdRRV9hYkkyY3ZBN3U5eFJOUFhrUkREbG94dDNSSDg4SDRWY0ItbWdtSmhEOV9DOVBsWk93cFNYVUxyOGFQa0s0QnMyNVBpUnJiU29JSks1UQ==
