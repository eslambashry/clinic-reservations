# Copy to .env and fill in real values. Never commit the real .env (see .gitignore).

NODE_ENV=development
PORT=3000

# Local Docker Postgres+PostGIS. docker-compose overrides localhost with the
# `postgres` service hostname when the API/worker run in containers.
DATABASE_URL="postgresql://medsuper:medsuper@localhost:5432/medsuper?schema=public"
DIRECT_URL="postgresql://medsuper:medsuper@localhost:5432/medsuper?schema=public"

REDIS_ENABLED=true
REDIS_URL="redis://localhost:6379"

# Signs/verifies short-lived access JWTs (File 11 Part 07.1). Production
# requires a unique high-entropy secret of at least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-new-local-random-secret"

# Comma-separated browser-origin allowlist. Optional for local development —
# unset means "reflect any Origin". Production requires one or more HTTPS
# origins with no path, e.g. CORS_ALLOWED_ORIGINS="https://pharmacy.example,https://laboratory.example".
CORS_ALLOWED_ORIGINS=
# Production startup also requires REDIS_ENABLED=true, SMS_PROVIDER=smsmisr
# and SMSMISR_ENVIRONMENT=live.

# OTP SMS via SMS Misr (DEC-003, File 12 Part 54) — login/signup and
# password-reset codes only. Unset or "logging" prints OTP codes to the log
# instead of sending them (dev-only). "smsmisr" requires the SMSMISR_*
# username/password/sender at boot. Get them from https://sms.com.eg/Client/Settings (API
# username/password — not your login — and the Sender Token) and the
# approved OTP template's token (optional: unset sends the code as free
# text via the SMS API until the template is approved). SMSMISR_ENVIRONMENT=test (default) is
# accepted by SMS Misr but delivers nothing; use live once the sender and
# template are approved.
SMS_PROVIDER=
SMSMISR_ENVIRONMENT=test
SMSMISR_USERNAME=
SMSMISR_PASSWORD=
SMSMISR_SENDER=
SMSMISR_OTP_TEMPLATE=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Optional — login password `npm run db:seed` sets on demo PHARMACY_STAFF/
# LAB_STAFF accounts. Local-dev-only, never a real credential; unset uses a
# fixed fallback (see src/db/seed.ts).
SEED_DEMO_STAFF_PASSWORD=

# Paymob (DEC-001, File 12 Parts 50/55) — CARD payments only (appointment
# card payments and wallet top-up). All optional: leave unset to run with
# card disabled. Get them from https://accept.paymob.com -> Settings ->
# Account Info (API key, HMAC secret) and Developers -> Payment
# Integrations (card integration ID, iframe ID).
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# FawryPay (File 12 Parts 50/55) — FAWRY (pay at Fawry outlets / myFawry)
# and MOBILE_WALLET (Fawry MWALLET, Request-to-Pay). All optional: leave
# unset to run with both disabled. Merchant code and secure key come from
# the FawryPay merchant account setup. FAWRY_BASE_URL defaults to the
# staging host (https://atfawry.fawrystaging.com); set it explicitly for
# production. Configure the server-notification URL in the Fawry merchant
# portal as https://<api-host>/v1/webhooks/payments/fawry.
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_BASE_URL=

# Firebase Cloud Messaging (File 12 Part 53) — all optional, same reasoning
# as PAYMOB_*: the app boots without them, but every push notification then
# fails at send time with PUSH_PROVIDER_NOT_CONFIGURED. Set these in any
# environment that is expected to actually deliver push. Get them from the
# Firebase console -> Project Settings -> Service accounts -> "Generate new
# private key", which downloads a JSON file holding all three values.
# FIREBASE_PRIVATE_KEY is the multi-line PEM from that JSON with its real
# newlines kept escaped as \n, on a single line and quoted.
# Firebase Cloud Messaging (File 12 Part 53). Set FIREBASE_PROJECT_ID for push.
# On Google Cloud, use the runtime service account via ADC and grant it FCM
# send permission in this Firebase project; do not create a key. The optional
# service-account pair is for non-Google hosts and belongs in a secret manager.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# A waiting appointment becomes "انتهى الموعد" after its slot end time plus
# this grace period. The worker checks eligible appointments every 5 minutes.
APPOINTMENT_END_GRACE_MINUTES=30
